{
  "name": "@ingst/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for the ingst event ingestion API",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint .",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
